{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "vercel-php"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/s/portal.php"
    },
    {
      "src": "^/(.*\\.php)$",
      "dest": "/api/$1"
    },
    {
      "src": "/s/portal.php",
      "dest": "/api/login.php"
    }
  ]
}
